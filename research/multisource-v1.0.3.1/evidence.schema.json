{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vera.invalid/schema/multisource-evidence-v1",
  "title": "Vera evidence envelope v1 with policy 1.1.0 scope extension",
  "type": "object",
  "required": [
    "schema",
    "policy",
    "dataset",
    "estimator_enabled",
    "prior_promotion_enabled",
    "native_baseline",
    "sources",
    "claims",
    "research_plan",
    "source_review",
    "rollout"
  ],
  "properties": {
    "schema": {
      "const": "vera.multisource.evidence.v1"
    },
    "policy": {
      "const": "vera.multisource.claim-policy.v1.1.0"
    },
    "dataset": {
      "const": "augmented_research_only"
    },
    "estimator_enabled": {
      "const": false
    },
    "prior_promotion_enabled": {
      "const": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "research_plan": {
      "type": "object"
    },
    "source_review": {
      "type": [
        "object",
        "null"
      ]
    },
    "rollout": {
      "type": "object"
    },
    "research_scope": {
      "type": "object",
      "required": [
        "selected_claim_ids",
        "context_links"
      ],
      "properties": {
        "selected_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "context_links": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "precision_withdrawal": {
          "type": "object",
          "required": [
            "claim_id",
            "source_id",
            "previous_dataset_reference",
            "previous_dataset_sha256",
            "original_parent_sha256",
            "previous_source_snapshot_sha256",
            "corrected_source_snapshot_sha256",
            "corrected_material_sha256",
            "original_document_reference",
            "ownership_audit_reference",
            "ownership_audit_sha256",
            "time_diff",
            "reviews"
          ],
          "description": "Narrow reviewed unsupported-precision withdrawal; semantic implementation independently computes diff and original DOM ownership. See PRECISION_WITHDRAWAL.md."
        }
      },
      "description": "Optional selected-scope extension; see SCOPED_SCHEMA.md and semantic validator."
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "url",
        "publisher",
        "source_type",
        "origin_family",
        "origin_rationale",
        "upstream_urls",
        "relationship",
        "capture",
        "capture_sha256",
        "original_sha256",
        "capture_scope",
        "original_body_inspected",
        "retrieved_at",
        "retrieval_missingness",
        "publication_date",
        "as_of_date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "origin_family": {
          "type": "string",
          "minLength": 1
        },
        "origin_rationale": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        },
        "capture": {
          "type": "string",
          "minLength": 1
        },
        "capture_scope": {
          "type": "string",
          "minLength": 1
        },
        "original_body_inspected": {
          "type": "boolean"
        },
        "upstream_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieval_missingness": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of_date": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "company_id",
        "round_id",
        "claim_type",
        "assertion",
        "value",
        "time",
        "identity",
        "evidence",
        "contradictions",
        "missingness",
        "collector",
        "reviews",
        "predicate_review"
      ],
      "properties": {
        "claim_type": {
          "enum": [
            "acquisition_completed",
            "acquisition_intent",
            "asset_acquisition",
            "bankruptcy_petition",
            "business_cessation",
            "control_transfer",
            "database_reported_lead",
            "final_liquidation",
            "legal_active",
            "legal_dissolution",
            "operating_activity",
            "operational_autonomy_reported",
            "priced_equity",
            "product_activity",
            "realized_investor_return",
            "reporting_termination",
            "safe_cap",
            "shareholder_consideration",
            "transaction_enterprise_value"
          ]
        },
        "time": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "activity_period",
                "event_interval",
                "point",
                "unknown",
                "upper_bound"
              ]
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "excerpt",
              "locator",
              "stance"
            ],
            "properties": {
              "stance": {
                "enum": [
                  "supports",
                  "contradicts"
                ]
              }
            }
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reviewer",
              "decision",
              "rationale",
              "identity_checked",
              "reviewed_at",
              "claim_sha256",
              "source_snapshot_sha256"
            ]
          }
        }
      }
    }
  }
}
