{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vera.local/schema/phase1d-identity-review.json",
  "title": "Vera Phase 1D identity review queue item",
  "type": "object",
  "required": ["review_id", "round_id_a", "round_id_b", "match_decision", "medium_identifiers_shared", "review_status"],
  "properties": {
    "review_id": {"type": "string"},
    "round_id_a": {"type": "string"},
    "round_id_b": {"type": "string"},
    "match_decision": {"enum": ["MATCH", "NO_MATCH", "NEEDS_REVIEW", "FALSE_SPLIT_RISK"]},
    "medium_identifiers_shared": {"type": "array", "items": {"type": "string"}},
    "strong_id_match": {"type": "boolean"},
    "review_status": {"enum": ["pending", "reviewed_match", "reviewed_no_match", "audit_pass", "audit_fail"]},
    "reviewer_notes": {"type": "string"},
    "false_match_risk": {"type": "number", "minimum": 0, "maximum": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
