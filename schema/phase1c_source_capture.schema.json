{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vera.local/schema/phase1c-source-capture.json",
  "title": "Vera Phase 1C source capture",
  "type": "object",
  "required": [
    "capture_id",
    "platform",
    "url",
    "page_type",
    "captured_at",
    "availability",
    "content_sha256"
  ],
  "properties": {
    "capture_id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "wefunder",
        "startengine",
        "crowdcube",
        "republic_us",
        "republic_europe"
      ]
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "page_type": {
      "enum": [
        "campaign",
        "hosted_document",
        "issuer_update",
        "platform_portfolio",
        "funded_listing",
        "secondary_page"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "availability": {
      "enum": [
        "PUBLIC_VISIBLE",
        "AUTH_REQUIRED",
        "UNAVAILABLE"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "round_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
